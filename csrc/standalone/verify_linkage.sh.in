#!/usr/bin/env bash
# Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.
# Licensed under the Apache License, Version 2.0.
#
# Generated by csrc/standalone/CMakeLists.txt into the build tree.
#
# Asserts the three linkage properties the brief asks to be verified:
#   1. zero undefined symbols (ldd -r)
#   2. no libpython and no libtorch anywhere in the dependency closure
#   3. libopapi survived --as-needed, so dlsym(RTLD_DEFAULT, ...) can see the
#      operator entry points at run time
#
# Exits non-zero, naming the binary and the property, on any failure.

set -u
set -o pipefail

CANN_LIB_DIR="@DSV4_CANN_LIB_DIR@"
export LD_LIBRARY_PATH="${CANN_LIB_DIR}:${LD_LIBRARY_PATH:-}"

failures=0

fail() {
  echo "  [FAIL] $1"
  failures=$((failures + 1))
}

pass() {
  echo "  [ ok ] $1"
}

for binary in "$@"; do
  name="$(basename "${binary}")"
  echo "== ${name} =="

  if [ ! -x "${binary}" ]; then
    fail "${name}: not an executable file"
    continue
  fi

  # --- 1. undefined symbols ------------------------------------------------
  # `ldd -r` prints "undefined symbol:" lines for anything the closure cannot
  # satisfy. Counted rather than grep -q: under pipefail, grep -q exits on the
  # first match, strings/ldd take SIGPIPE, and the pipeline reports 141, which
  # reads as "no match" even when there was one.
  ldd_output="$(ldd -r "${binary}" 2>&1)"
  undefined="$(printf '%s\n' "${ldd_output}" | grep -c 'undefined symbol' || true)"
  if [ "${undefined}" -eq 0 ]; then
    pass "${name}: zero undefined symbols"
  else
    fail "${name}: ${undefined} undefined symbol(s)"
    printf '%s\n' "${ldd_output}" | grep 'undefined symbol' | head -20 | sed 's/^/        /'
  fi

  notfound="$(printf '%s\n' "${ldd_output}" | grep -c 'not found' || true)"
  if [ "${notfound}" -eq 0 ]; then
    pass "${name}: every DT_NEEDED resolved"
  else
    fail "${name}: ${notfound} shared object(s) not found"
    printf '%s\n' "${ldd_output}" | grep 'not found' | sed 's/^/        /'
  fi

  # --- 2. no Python, no Torch ---------------------------------------------
  for forbidden in libpython libtorch libc10 libtorch_npu; do
    hits="$(printf '%s\n' "${ldd_output}" | grep -c "${forbidden}" || true)"
    if [ "${hits}" -eq 0 ]; then
      pass "${name}: no ${forbidden} in the dependency closure"
    else
      fail "${name}: ${forbidden} appears ${hits} time(s) in the dependency closure"
    fi
  done

  # Also check DT_NEEDED directly: a framework linked but unused would still be
  # a dependency this binary must not have.
  needed="$(readelf -d "${binary}" 2>/dev/null | grep 'NEEDED' | sed 's/.*\[\(.*\)\]/\1/' | sort)"
  framework="$(printf '%s\n' "${needed}" | grep -c -E 'libpython|libtorch|libc10' || true)"
  if [ "${framework}" -eq 0 ]; then
    pass "${name}: DT_NEEDED is framework-free"
  else
    fail "${name}: DT_NEEDED names a Python/Torch library"
  fi

  # --- 3. libopapi survived --as-needed -----------------------------------
  opapi="$(printf '%s\n' "${needed}" | grep -c 'libopapi' || true)"
  if [ "${opapi}" -gt 0 ]; then
    pass "${name}: libopapi is in DT_NEEDED, so RTLD_DEFAULT can reach the operators"
  else
    fail "${name}: libopapi was dropped from DT_NEEDED; the dlsym'd operators would not resolve"
  fi

  echo "  DT_NEEDED:"
  printf '%s\n' "${needed}" | sed 's/^/        /'
done

echo
if [ "${failures}" -eq 0 ]; then
  echo "linkage verification passed"
  exit 0
fi
echo "linkage verification failed: ${failures} problem(s)"
exit 1
